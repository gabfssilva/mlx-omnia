<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>OmniaPanel</string>
	<key>CFBundleIdentifier</key>
	<string>dev.omnia.panel</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MLX Omnia</string>
	<key>CFBundleDisplayName</key>
	<string>MLX Omnia</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- What a checkout builds. `build.sh` overwrites both in the copy inside the .app:
	     the tag is what the panel shows, and Sparkle compares CFBundleVersion, so that one
	     is the commit count — a number that goes up before the first tag exists. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock tile, no ⌘-Tab, no application menu: the icon in the bar is the app. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The daemon is on the loopback, which the sandbox would still ask about; this app
	     is unsandboxed and signed ad-hoc, so the key is here to say what it reaches. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Sparkle's whole configuration; `Updates` hands it nothing but the decision to
	     start. SUPublicEDKey is what makes an update acceptable and is missing until
	     `mise run sparkle:keys` has printed one — absent, the panel ships with no updater
	     at all rather than one that would take an unsigned update on trust. -->
	<key>SUFeedURL</key>
	<string>https://gabfssilva.github.io/mlx-omnia/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- <key>SUPublicEDKey</key><string></string> -->
</dict>
</plist>
